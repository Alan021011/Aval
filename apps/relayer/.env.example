# Cuenta que paga el gas del relayer. SOLO TESTNET: genera una nueva (`cast wallet new`) y cárgala desde
# https://faucet.monad.xyz. Nunca uses una cuenta con fondos reales ni una clave personal.
RELAYER_PRIVATE_KEY=0x

RPC_URL=https://testnet-rpc.monad.xyz
PORT=8787

# Orígenes del navegador que pueden llamar al relayer (separados por comas).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5180

# Actívalo solo detrás de un proxy de confianza (Vercel, nginx…). Si no, cualquiera podría falsear su IP.
TRUST_PROXY=false

# Tokens con los que el relayer trabaja (por defecto, el tUSD del despliegue en testnet).
# ALLOWED_TOKENS=0xeD4Bb1e1926441461BcADA4BBF647Aba8574B3C5

# Si el saldo baja de esto, el relayer deja de enviar en vez de vaciarse.
MIN_BALANCE_MON=0.5

# Límites opcionales (los valores por defecto están en src/limits.ts).
# PER_IP_PER_MINUTE=30
# PER_OWNER_PER_MINUTE=10
# MAX_TX_PER_DAY=2000
# FAUCET_AMOUNT_TUSD=500
# FAUCET_COOLDOWN_SECONDS=3600

# Reintentos cuando otra instancia del servicio se adelanta con el mismo nonce (importante en Vercel).
# MAX_NONCE_RETRIES=4
