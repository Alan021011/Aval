{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && npm install",
  "buildCommand": "cd ../.. && npm run build:sdk",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/health", "destination": "/api" },
    { "source": "/relay/:kind", "destination": "/api" },
    { "source": "/faucet", "destination": "/api" },
    { "source": "/agent/:action", "destination": "/api" }
  ]
}
