{
  "name": "@aval/relayer",
  "version": "0.1.0",
  "private": true,
  "description": "Relayer de Aval: envía las transacciones que el usuario firmó y paga el gas, sin tocar nunca sus claves",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "viem": "^2.57.4",
    "zod": "^4.6.5",
    "@aval/sdk": "*"
  }
}
